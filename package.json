{
  "name": "dashops",
  "version": "0.1.0",
  "private": true,
  "description": "DashOps — a food-delivery-flavored agent platform demo on Restate. Operator agent + agent gateway + async human-in-the-loop approval.",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "restate:up": "docker compose up -d restate",
    "restate:down": "docker compose down",
    "restate:logs": "docker compose logs -f restate",
    "register": "bash scripts/register.sh",
    "dev:gateway": "npm --workspace=@dashops/gateway run dev",
    "dev:tools": "npm --workspace=@dashops/tools run dev",
    "dev:ops": "npm --workspace=@dashops/ops-agent run dev"
  },
  "engines": {
    "node": ">=20"
  }
}
